@startuml
left to right direction
actor Клиент
actor "Оператор первой линии" as Operator
actor "Специалист второй линии" as Specialist

rectangle "Система разбора обращений" {
  usecase "Подготовить ответ\nпо базе знаний" as UC1
  usecase "Передать обращение\nспециалисту" as UC2
  usecase "Безопасно обработать\nнедоверенный текст" as UC3
}

Клиент --> UC1 : обращение
Клиент --> UC2 : обращение
Клиент --> UC3 : обращение
Operator --> UC1 : проверить и отправить
Operator --> UC2 : проверить и подтвердить
Operator --> UC3 : проверить результат
Specialist --> UC2 : принять в работу
UC3 ..> UC1 : безопасный типовой запрос
UC3 ..> UC2 : риск или недостаточно данных
@enduml